{
  "rules": {
    ".read": false,
    ".write": false,
    "activePlusSync": {
      "v1": {
        "staffAccounts": {
          ".read": "auth != null",
          "$role": {
            ".write": "auth != null && ($role === 'admin' || $role === 'manager' || $role === 'teacher' || $role === 'payment')",
            ".validate": "newData.hasChildren(['username', 'password']) && newData.child('username').isString()"
          }
        },
        "staffDirectory": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChild('version')"
        },
        "usernames": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "studentAccount": {
          ".read": "auth != null"
        },
        "studentAccounts": {
          ".read": "auth != null",
          "$loginKey": {
            ".write": "auth != null",
            ".validate": "newData.hasChild('pinHash')"
          }
        },
        "examDb": {
          ".read": "auth != null",
          "exams": {
            ".write": "auth != null",
            "$examId": {
              ".write": "auth != null",
              ".validate": "newData.child('id').val() === $examId && newData.child('teacherId').isString() && newData.child('status').isString()"
            }
          },
          "attempts": {
            ".write": "auth != null",
            "$attemptId": {
              ".write": "auth != null",
              ".validate": "newData.child('id').val() === $attemptId && newData.child('examId').isString() && newData.child('studentId').isString()"
            }
          }
        },
        "system": {
          ".read": "auth != null",
          "adminInitialized": {
            ".write": "auth != null && (!newData.exists() || newData.isBoolean())",
            ".validate": "newData.isBoolean()"
          },
          "connectivityProbe": {
            "$probeKey": {
              ".write": "auth != null && $probeKey.length <= 64",
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "adviceBank": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.status === 'active' && auth.token.mustChangePassword !== true && (auth.token.role === 'admin' || auth.token.role === 'manager')",
          "$adviceId": {
            ".validate": "newData.numChildren() === 6 && newData.hasChildren(['text', 'source', 'active', 'order', 'createdBy', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 140 && newData.child('source').isString() && newData.child('source').val().length > 0 && newData.child('source').val().length <= 120 && newData.child('active').isBoolean() && newData.child('order').isNumber() && newData.child('order').val() >= 1 && newData.child('createdBy').isString() && newData.child('createdBy').val().length > 0 && newData.child('createdBy').val().length <= 128 && newData.child('createdAt').isNumber() && newData.child('createdAt').val() >= 0"
          }
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "pushTokens": {
          "$deviceKey": {
            ".write": "auth != null",
            ".validate": "newData.child('token').isString() && newData.child('token').val().length > 20 && newData.child('token').val().length <= 4096"
          }
        },
        "students": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "transactions": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "notices": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "routine": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "teaching": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "academics": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "courseContent": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "courses": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        },
        "teacherAssignments": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$recordId": {
            ".validate": "newData.hasChildren()"
          }
        }
      }
    }
  }
}
