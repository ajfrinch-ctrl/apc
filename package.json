{
  "name": "active-plus-coaching",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/node-test-setup.mjs --test --test-concurrency=1 --test-force-exit tests/*.test.mjs",
    "build:firebase": "node tools/build-firebase.mjs",
    "build:supabase": "node tools/build-supabase.mjs",
    "build:teacher-css": "tailwindcss -c tailwind.config.cjs -i css/tailwind/teacher.src.css -o css/teacher-panel.css --minify",
    "preflight:ledger": "node tools/ledger-migration-preflight.mjs",
    "compare:ledger-backups": "node tools/ledger-backup-compare.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "node tools/e2e-run.mjs",
    "rehearse:cutover": "node --import ./tests/node-test-setup.mjs --test --test-force-exit tests/v2-cutover-rehearsal.test.mjs tests/rtdb-v2-draft-rules.test.mjs tests/teacher-assignment-migration.test.mjs tests/v2-roster-migration.test.mjs tests/question-bank-v2-policy.test.mjs tests/question-bank-v2-projection.test.mjs tests/notices-v2-policy.test.mjs tests/notices-v2-projection.test.mjs tests/admin-v2-migration.test.mjs",
    "build:qrcode": "node tools/build-qrcode.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.0.0",
    "jsdom": "^30.1.3",
    "qrcode-generator": "2.0.4",
    "tailwindcss": "^3.4.17"
  }
}
