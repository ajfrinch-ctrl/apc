rules_version = '2';

/* Active Plus Coaching — Firestore security rules.
   Phase 10 staging only: NO deploy until emulator role tests, identity mapping,
   index inventory and adapter cutover are complete. The live client still
   uses localStorage + the legacy RTDB bridge (database.rules.json).

   Layers enforced here:
     • roles come ONLY from Auth custom claims (`role`, `status`,
       `mustChangePassword`) — never from a document field;
     • exam answer keys live under `exams/{examId}/private/key` and students
       can never read them; scoring + answer release happen in the Cloud
       Function `releaseExamResults`, and only after the exam window ends;
     • staged Teacher submission, Manager publishing, Student attempts and
       release scoring are server-only; the live local workflow is unchanged;
     • the payment counter reads approved students only through the limited
       `studentSummaries` projection (name, Student ID, class, mobile, monthly
       fee) and only its own ledger rows; reviewed receipts are immutable and
       corrections live in separate one-per-receipt decision records;
     • attempts / results / attendance / homework submissions are readable
       only by the owner or authorized staff; all writes are server-only. */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    /* Active = the same condition the client's session gate uses: the account
       claims an operational role and does not sit on a temporary password. */
    function active() {
      return isSignedIn() && request.auth.token.get('status', '') in ['active', 'approved']
        && request.auth.token.get('mustChangePassword', false) != true;
    }

    function isAdmin() { return active() && request.auth.token.role == 'admin'; }
    function isStaffAdmin() { return isAdmin(); }
    function isStaffManager() { return active() && request.auth.token.role == 'manager'; }
    function isPayment() { return active() && request.auth.token.role == 'payment'; }
    function isTeacher() { return active() && request.auth.token.role == 'teacher'; }
    function isStudent() { return active() && request.auth.token.role == 'student'; }
    function isStaff() { return isStaffAdmin() || isStaffManager() || isTeacher() || isPayment(); }

    /* A teacher's assigned classes ride in the `classes` claim the
       provisioning callables stamp on the account (js/staff-directory.js
       `record.assignment.classes` shape). Missing claim = no class = no
       class-scoped access (deny by default). */
    function assignedClasses() {
      return request.auth.token.get('classes', []) is list ? request.auth.token.get('classes', []) : [];
    }
    function studentRecord(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data;
    }
    function studentClass() { return studentRecord(request.auth.uid).className; }
    function studentGroup() { return studentRecord(request.auth.uid).get('group', ''); }
    function classOfStudent(studentId) { return studentRecord(studentId).className; }

    // ---------------------------------------------------------------------
    // Auth/profile identity: server-only mutations, never client-created roles.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAdmin() || (active() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Enrollment handle reservations are never browser-readable or writable;
    // do not expose a directory of usernames or allow client claim-squatting.
    match /usernameIndex/{username} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // students
    //
    // The MAIN document is the shared identity record. Sensitive fields
    // (guardian mobile, address, NID, notes, photo …) belong under
    // `students/{studentId}/private/*` — the payment counter and teachers
    // can never read those. The payment counter doesn't read the main
    // document at all; neither does Teacher until legacy fields are audited.
    // Both use the limited `studentSummaries` projection below.
    //
    // Manager review uses managerReviewStudent (Admin SDK), which atomically
    // updates users/{uid} and students/{uid} then refreshes Auth claims.
    // No browser may change student status or delete an identity document.
    // ---------------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isAdmin()
        || (isStaffManager() && resource.data.status in ['pending', 'approved'])
        || (isStudent() && request.auth.uid == studentId);
      allow create: if false;
      // Even Admin cannot client-set status/UID: only non-authority profile edits.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'fullName', 'mobile', 'classId', 'className', 'group', 'monthlyFee']);
      allow delete: if false;

      /* Sensitive profile: self, Manager and Admin only. */
      match /private/{document} {
        allow read: if isStaffAdmin() || isStaffManager()
          || (isStudent() && request.auth.uid == studentId);
        allow write: if false; // server-managed private data until schema review
      }
    }

    /* Limited student surface for the payment counter: exactly the fields the
       desk may see (name, Student ID, class, mobile, monthly fee) + status.
       Server-maintained projection only; never by any browser role. */
    match /studentSummaries/{studentId} {
      allow read: if isAdmin()
        || (isStaffManager() && resource.data.status in ['pending', 'approved'])
        || (isTeacher() && resource.data.status == 'approved' && resource.data.className in assignedClasses())
        || (isPayment() && resource.data.status == 'approved');
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // exams
    //
    // The main exam must not carry answers. Firestore rules cannot validate
    // arbitrary nested question arrays: only trusted server code may create
    // drafts, keys or transition them. The released document lives under
    // exams/{examId}/releasedKey/answers.
    // ---------------------------------------------------------------------
    function ownsExam() { return resource.data.teacherUid == request.auth.uid; }
    function examForStudentOwned(examId) {
      return get(/databases/$(database)/documents/exams/$(examId)).data.teacherUid == request.auth.uid;
    }
    function examForStudent(examId) {
      let paper = get(/databases/$(database)/documents/exams/$(examId)).data;
      return paper.status == 'published' && paper.resultsReleased == true
        && paper.className == studentClass()
        && (paper.get('group', '') == '' || paper.get('group', '') == studentGroup());
    }

    match /exams/{examId} {
      allow read: if isStaffAdmin() || isStaffManager()
        || (isTeacher() && (ownsExam() || resource.data.status == 'published'))
        || (isStudent() && resource.data.status == 'published' && resource.data.className == studentClass()
          && (resource.data.get('group', '') == '' || resource.data.get('group', '') == studentGroup()));
      // No client may smuggle answers into a nested question or publish/erase
      // an exam. managerReviewExam (Admin/Manager) uses the Admin SDK after server validation.
      allow create, update, delete: if false;

      /* Answer key + private exam material: never readable by students. */
      match /private/{document} {
        allow read: if isStaffAdmin() || isStaffManager()
          || (isTeacher() && examForStudentOwned(examId));
        allow write: if false; // no browser may replace a scoring key
      }

      /* Valid document: exams/{examId}/releasedKey/answers. Only the server
         publishes after the exam ends; no browser may write its answers. */
      match /releasedKey/{document} {
        allow read: if document == 'answers' && (isStaffAdmin() || isStaffManager()
          || (isTeacher() && examForStudentOwned(examId))
          || (isStudent() && resource.data.releasedAt is timestamp && examForStudent(examId)));
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Questions and bank: no student reads until a reviewed public projection
    // and key-hiding schema exist. Server-only writes prevent answer leaks.
    // ---------------------------------------------------------------------
    match /questions/{questionId} {
      allow read: if isStaffAdmin() || isStaffManager() || isTeacher();
      allow create, update, delete: if false;
    }

    match /questionBank/{questionId} {
      allow read: if isStaffAdmin() || isStaffManager() || isTeacher();
      allow create, update, delete: if false;
    }

    match /questionBankDrafts/{draftId} {
      allow read: if isStaff();
      allow create: if isTeacher() || isStaffManager() || isStaffAdmin();
      allow update: if (isTeacher() && request.auth.uid == resource.data.teacherUid) || isStaffManager() || isStaffAdmin();
      allow delete: if isStaffManager() || isStaffAdmin();
    }

    // ---------------------------------------------------------------------
    // transactions — the money ledger
    //
    // Counter reads only own rows; Admin reads all. Phase 8 trusted callables
    // create server-numbered pending rows and Manager decides via a scoped
    // inspection callable. Reversal/settlement is NOT implemented: client-side
    // receipt fields cannot prove money received.
    // ---------------------------------------------------------------------
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isPayment() && resource.data.createdBy == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Reservation and counter sequence documents are Admin SDK-only; even
    // Admin cannot bypass receipt numbering from a browser.
    match /receiptSequences/{counterId} {
      allow read, write: if false;
    }
    match /receiptNumbers/{receiptNo} {
      allow read, write: if false;
    }
    match /paymentReferences/{referenceId} {
      allow read, write: if false;
    }

    // Separate one-per-receipt accounting decision. Never browser-write
    // or expose the Manager's free-text reason via a broad ledger query.
    match /paymentReversals/{receiptId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // reports / academicReports / settings — unchanged
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /academicReports/{reportId} {
      allow read: if isAdmin() || isStaffManager() || isTeacher();
      allow write: if false; // server-managed reports until per-class schema
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // notices — write: Manager + Admin only
    // ---------------------------------------------------------------------
    match /notices/{noticeId} {
      allow read: if isStaff(); // student targeting requires a reviewed scope schema
      allow create, update, delete: if isStaffManager() || isStaffAdmin();
    }

    // ---------------------------------------------------------------------
    // routine — write: Manager + Admin (any row), Teacher only their own
    // `teacherUid` rows
    // ---------------------------------------------------------------------
    match /routine/{routineId} {
      allow read: if isStaff(); // student targeting requires a reviewed scope schema
      allow create: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid
          && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // ---------------------------------------------------------------------
    // teaching resources — write: Manager + Admin + the owning Teacher
    // (teacher writes require teacherUid == request.auth.uid; Admin excepted).
    // Students read only published rows of their own class/section.
    // ---------------------------------------------------------------------
    function teachingForStudent() {
      return resource.data.status == 'published'
        && resource.data.className == studentClass()
        && (resource.data.group == null || resource.data.group == '' || resource.data.group == studentGroup());
    }

    // ---------------------------------------------------------------------
    // courses — teacher creates/updates own teacherId courses; students read
    // only published courses of their own class/section.
    // ---------------------------------------------------------------------
    function teacherIdClaim() {
      return request.auth.token.get('teacherId', request.auth.uid) is string
        ? request.auth.token.get('teacherId', request.auth.uid) : request.auth.uid;
    }
    function ownsCourse(data) {
      return data.teacherUid == request.auth.uid || data.teacherId == teacherIdClaim();
    }
    function courseForStudent() {
      return resource.data.status == 'published'
        && resource.data.className == studentClass()
        && (resource.data.group == null || resource.data.group == '' || resource.data.group == studentGroup());
    }

    match /courses/{courseId} {
      allow read: if isStaffAdmin() || isStaffManager()
        || (isTeacher() && (ownsCourse(resource.data) || resource.data.status == 'published'))
        || (isStudent() && courseForStudent());
      allow create: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && ownsCourse(request.resource.data));
      allow update: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && ownsCourse(resource.data) && ownsCourse(request.resource.data));
      allow delete: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && ownsCourse(resource.data));
    }

    match /teaching/{teachingId} {
      allow read: if isStaffAdmin() || isStaffManager()
        || (isTeacher() && (resource.data.teacherUid == request.auth.uid || resource.data.status == 'published'))
        || (isStudent() && teachingForStudent());
      allow create: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid
          && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isStaffManager() || isStaffAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // ---------------------------------------------------------------------
    // studentApprovals — server-managed audit trail; Manager may read it.
    // ---------------------------------------------------------------------
    match /studentApprovals/{approvalId} {
      allow read: if isStaffAdmin() || isStaffManager();
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // attempts / results / attendance / homeworkSubmissions
    //
    // A student reads only their own rows; teachers read assigned classes,
    // Manager/Admin read all. Direct creates are closed pending server checks
    // for exam windows, attendance, submissions and scoring.
    // ---------------------------------------------------------------------
    function ownRow(row) {
      return row.studentId is string && row.studentId == request.auth.uid;
    }
    function classRow(row) {
      return row.studentId is string && classOfStudent(row.studentId) in assignedClasses();
    }
    function staffRowRead(row) {
      return isStaffAdmin() || isStaffManager() || (isTeacher() && classRow(row));
    }

    match /attempts/{attemptId} {
      allow read: if staffRowRead(resource.data) || (isStudent() && ownRow(resource.data));
      allow create: if false; // server validates exam window / attendance ownership
      allow update: if false;
      allow delete: if false;
    }

    function resultReleased(row) {
      return row.examId is string
        && get(/databases/$(database)/documents/exams/$(row.examId)).data.resultsReleased == true;
    }

    match /results/{resultId} {
      allow read: if staffRowRead(resource.data) || (isStudent() && ownRow(resource.data) && resultReleased(resource.data));
      allow create: if false; // only releaseExamResults may mint scores
      allow update: if false;
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if staffRowRead(resource.data) || (isStudent() && ownRow(resource.data));
      allow create: if false; // server validates exam window / attendance ownership
      allow update: if false;
      allow delete: if false;
    }

    match /homeworkSubmissions/{submissionId} {
      allow read: if staffRowRead(resource.data) || (isStudent() && ownRow(resource.data));
      allow create: if false; // server validates exam window / attendance ownership
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
